# Copy this file to `.env` (optional). Credentials are normally entered in the
# app UI; the values here are only fallbacks used when none are entered there.

# fm-track
# FM_TRACK_API_KEY=your-api-key-here
# FM_TRACK_BASE_URL=https://api.fm-track.com

# CargoTrack
# CARGOTRACK_USERNAME=your-username
# CARGOTRACK_PASSWORD=your-password
# CARGOTRACK_BASE_URL=https://api.cargotrack.ro

# PORT=3000
